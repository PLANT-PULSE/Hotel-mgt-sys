# Enterprise SaaS Booking Platform – Environment Variables

# ==================== DATABASE ====================
DATABASE_URL=postgresql://user:password@localhost:5432/booking_saas

# ==================== BACKEND API ====================
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==================== AUTH ====================
JWT_SECRET=your-jwt-secret-min-32-chars
SUPER_ADMIN_EMAIL=superadmin@platform.com
SUPER_ADMIN_PASSWORD=Password123!
ADMIN_EMAIL=admin@luxehotel.com
ADMIN_PASSWORD=Password123!

# NextAuth (optional – for session-based auth)
AUTH_SECRET=your-auth-secret-min-32-chars
AUTH_URL=http://localhost:3000

# ==================== AI (Groq – server-side only) ====================
GROQ_API_KEY=gsk_your_groq_api_key

# ==================== EMAIL (Resend) ====================
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=Bookings <noreply@yourdomain.com>

# ==================== PAYMENTS ====================
# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_SECRET_KEY=sk_test_your_secret_key

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_public

# ==================== STORAGE ====================
BLOB_READ_WRITE_TOKEN=vercel_blob_token

# ==================== MULTI-TENANT ====================
# Default platform domain for subdomain routing
PLATFORM_DOMAIN=localhost:3000
